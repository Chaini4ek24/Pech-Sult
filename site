<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Ресторан «Печь и соль» | Новосибирск</title>
    
    <!-- Подключение шрифтов -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-dark: #0f100f;
            --bg-card: #181a18;
            --bg-card-alt: #202220;
            --clay-orange: #D05A30;
            --clay-bright: #E86A3E;
            --olive-deep: #2A3326;
            --warm-ash: #E5E0D8;
            --text-muted: #9E988F;
            --border: rgba(229, 224, 216, 0.12);
            --border-glow: rgba(208, 90, 48, 0.3);
            --font-title: 'Playfair Display', serif;
            --font-body: 'Montserrat', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body {
            width: 100%;
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--bg-dark);
            color: var(--warm-ash);
            font-family: var(--font-body);
            line-height: 1.6;
        }

        h1, h2, h3, h4 { font-family: var(--font-title); font-weight: 500; }

        .container {
            width: 100%;
            max-width: 1240px;
            margin: 0 auto;
            padding: 0 24px;
        }

        /* HEADER */
        header {
            position: fixed;
            top: 0; left: 0; width: 100%;
            z-index: 1000;
            background: rgba(15, 16, 15, 0.92);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
        }

        .header-wrap {
            display: flex;
            justify-content: space-between;
            align-items: center;
            height: 85px;
        }

        .logo {
            font-family: var(--font-title);
            font-size: 1.8rem;
            color: var(--warm-ash);
            text-decoration: none;
            letter-spacing: 2px;
            text-transform: lowercase;
            font-style: italic;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .logo span { color: var(--clay-orange); font-style: normal; }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 36px;
        }

        .nav-links a {
            color: var(--warm-ash);
            text-decoration: none;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            transition: color 0.3s;
        }

        .nav-links a:hover { color: var(--clay-orange); }

        /* КНОПКИ С «ФИЗИКОЙ» */
        .btn-header, .btn-main, .btn-outline, .tab-btn {
            position: relative;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.25, 1, 0.5, 1);
            user-select: none;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            text-decoration: none;
        }

        .btn-header:active, .btn-main:active, .btn-outline:active, .tab-btn:active {
            transform: scale(0.95) translateY(2px) !important;
        }

        .btn-header {
            background: var(--clay-orange);
            color: #fff;
            padding: 12px 24px;
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 2px;
            border: none;
        }

        .btn-header:hover {
            background: var(--clay-bright);
            box-shadow: 0 6px 20px rgba(208, 90, 48, 0.4);
        }

        /* HERO SECTION С ВЕКТОРНОЙ АНИМИРОВАННОЙ ПЕЧЬЮ */
        .hero {
            min-height: 95vh;
            padding-top: 150px;
            padding-bottom: 80px;
            background: radial-gradient(circle at 50% 30%, rgba(208, 90, 48, 0.15) 0%, rgba(15, 16, 15, 0.98) 70%);
            display: flex;
            align-items: center;
            text-align: center;
            position: relative;
        }

        .hero-tag {
            color: var(--clay-orange);
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 4px;
            margin-bottom: 20px;
            display: inline-block;
        }

        .hero h1 {
            font-size: 4.5rem;
            line-height: 1.1;
            margin-bottom: 24px;
        }

        .hero h1 em {
            font-style: italic;
            color: var(--clay-bright);
            text-shadow: 0 0 30px rgba(232, 106, 62, 0.3);
        }

        /* ИЛЛЮСТРАЦИЯ ДРОВЯНОЙ ПЕЧИ */
        .hero-oven-svg {
            width: 140px;
            height: 140px;
            margin: 0 auto 30px;
            filter: drop-shadow(0 0 25px rgba(208, 90, 48, 0.5));
            animation: flameGlow 3s ease-in-out infinite alternate;
        }

        @keyframes flameGlow {
            0% { transform: scale(1); filter: drop-shadow(0 0 20px rgba(208, 90, 48, 0.4)); }
            100% { transform: scale(1.04); filter: drop-shadow(0 0 35px rgba(232, 106, 62, 0.7)); }
        }

        .hero-desc {
            max-width: 700px;
            margin: 0 auto 40px;
            color: var(--text-muted);
            font-size: 1.1rem;
            font-weight: 300;
        }

        .hero-btns {
            display: flex;
            justify-content: center;
            gap: 20px;
            flex-wrap: wrap;
        }

        .btn-main {
            background: var(--clay-orange);
            color: #fff;
            padding: 16px 36px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.85rem;
            border-radius: 2px;
            border: none;
            box-shadow: 0 4px 15px rgba(208, 90, 48, 0.3);
        }

        .btn-main:hover {
            background: var(--clay-bright);
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(232, 106, 62, 0.5);
        }

        .btn-outline {
            border: 1px solid var(--warm-ash);
            color: var(--warm-ash);
            padding: 16px 36px;
            text-transform: uppercase;
            letter-spacing: 2px;
            font-size: 0.85rem;
            border-radius: 2px;
            background: transparent;
        }

        .btn-outline:hover {
            background: var(--warm-ash);
            color: var(--bg-dark);
            transform: translateY(-3px);
        }

        /* CONCEPT SECTION */
        .concept-sec {
            padding: 120px 0;
            background: var(--bg-dark);
            border-top: 1px solid var(--border);
        }

