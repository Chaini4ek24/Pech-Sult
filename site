<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Печь и Соль — Ресторан Сибирской Кухни</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@500;600;700&family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <style>
        :root {
            --bg-void: #090A09;
            --stone-dark: #121412;
            --stone-card: #181A18;
            --stone-card-hover: #222522;
            --ember-orange: #E65100;
            --ember-glow: #FF6F00;
            --ash-gold: #D4AF37;
            --gold-light: #F3E5AB;
            --text-light: #F5F2EB;
            --text-dim: #9A9893;
            --border: rgba(212, 175, 55, 0.15);
            --border-glow: rgba(255, 111, 0, 0.4);
            --font-serif: 'Cinzel', serif;
            --font-sans: 'Montserrat', sans-serif;
        }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html, body {
            width: 100%;
            background-color: var(--bg-void);
            color: var(--text-light);
            font-family: var(--font-sans);
            overflow-x: hidden;
            scroll-behavior: smooth;
        }

        #canvas-sparks {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 1;
        }

        /* HEADER */
        header {
            position: fixed;
            top: 0; left: 0; width: 100%;
            z-index: 100;
            padding: 24px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: linear-gradient(to bottom, rgba(9,10,9,0.95), transparent);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255,255,255,0.05);
        }

        .brand-logo {
            font-family: var(--font-serif);
            font-size: 1.6rem;
            letter-spacing: 3px;
            color: var(--text-light);
            text-decoration: none;
            text-transform: uppercase;
            font-weight: 700;
        }

        .brand-logo span { color: var(--ember-glow); }

        .btn-reserve-trigger {
            border: 1px solid var(--ash-gold);
            padding: 12px 28px;
            color: var(--ash-gold);
            text-decoration: none;
            font-size: 0.75rem;
            letter-spacing: 3px;
            text-transform: uppercase;
            transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            background: rgba(0,0,0,0.5);
            backdrop-filter: blur(5px);
            cursor: pointer;
            border-radius: 2px;
        }

        .btn-reserve-trigger:hover {
            background: var(--ash-gold);
            color: var(--bg-void);
            box-shadow: 0 0 25px rgba(212, 175, 55, 0.4);
            transform: translateY(-2px);
        }

        /* HERO SCREEN */
        .hero-screen {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            text-align: center;
            position: relative;
            z-index: 2;
            padding: 120px 20px 80px;
            background: radial-gradient(circle at 50% 40%, rgba(255, 111, 0, 0.12) 0%, rgba(9, 10, 9, 0.98) 75%);
        }

        .hearth-interactive {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            background: radial-gradient(circle, var(--ember-glow) 0%, var(--ember-orange) 45%, transparent 75%);
            margin-bottom: 35px;
            cursor: pointer;
            position: relative;
            box-shadow: 0 0 70px rgba(230, 81, 0, 0.6);
            transition: transform 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            display: flex;
            align-items: center;
            justify-content: center;
            border: 1px solid rgba(255, 111, 0, 0.3);
        }

        .hearth-interactive:hover {
            transform: scale(1.1);
            box-shadow: 0 0 100px rgba(255, 111, 0, 0.9);
        }

        .hearth-hint {
            position: absolute;
            bottom: -32px;
            font-size: 0.7rem;
            letter-spacing: 2px;
            color: var(--ash-gold);
            text-transform: uppercase;
            white-space: nowrap;
        }

        .hero-title {
            font-family: var(--font-serif);
            font-size: 4.8rem;
            line-height: 1.05;
            letter-spacing: 6px;
            margin-bottom: 20px;
            text-transform: uppercase;
            background: linear-gradient(to right, #FFFFFF, var(--gold-light), var(--text-dim));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-sub {
            font-size: 1.15rem;
            color: var(--text-dim);
            max-width: 650px;
            font-weight: 300;
            margin-bottom: 45px;
            letter-spacing: 1px;
            line-height: 1.7;
        }

        .section-padding {
            padding: 120px 0;
            position: relative;
            z-index: 2;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 30px;
        }

        .section-header {
            text-align: center;
            margin-bottom: 70px;
        }

        .story-badge {
            color: var(--ember-glow);
            font-size: 0.8rem;
            letter-spacing: 4px;
            text-transform: uppercase;
            margin-bottom: 15px;
            display: block;
        }

        .story-heading {
            font-family: var(--font-serif);
            font-size: 3.2rem;
            line-height: 1.2;
            color: var(--text-light);
        }

        /* МЕНЮ С АКЦЕНТНЫМИ КАРТОЧКАМИ И ФОТО-ПРЕВЬЮ */
        .menu-experience {
            background: var(--stone-dark);
            border: 1px solid var(--border);
            padding: 50px;
            border-radius: 6px;
            box-shadow: 0 30px 80px rgba(0,0,0,0.8);
        }

        .menu-nav {
            display: flex;
            justify-content: center;
            gap: 16px;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            padding-bottom: 30px;
            margin-bottom: 50px;
            flex-wrap: wrap;
        }

        .menu-tab {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-dim);
            font-family: var(--font-sans);
            font-size: 0.85rem;
            letter-spacing: 2px;
            text-transform: uppercase;
            padding: 12px 28px;
            border-radius: 30px;
            cursor: pointer;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .menu-tab:hover {
            color: var(--text-light);
            border-color: var(--ash-gold);
        }

        .menu-tab.active {
            background: var(--ember-orange);
            color: #FFF;
            border-color: var(--ember-glow);
            box-shadow: 0 4px 20px rgba(230, 81, 0, 0.5);
        }

        .menu-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px;
            min-height: 400px;
        }

        /* КАРТОЧКА БЛЮДА С ВИЗУАЛЬНЫМ БЛОКОМ */
        .dish-card {
            background: var(--stone-card);
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 6px;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            transition: all 0.35s ease;
            position: relative;
            animation: fadeIn 0.4s ease forwards;
        }

        /* Выделение топовых блюд шефа */
        .dish-card.featured {
            border: 1px solid var(--ash-gold);
            background: linear-gradient(145deg, #1e211e, #141614);
            box-shadow: 0 10px 30px rgba(212, 175, 55, 0.15);
        }

        .dish-card.featured::before {
            content: 'ВЫБОР ШЕФА';
            position: absolute;
            top: 15px; right: 15px;
            background: var(--ash-gold);
            color: #000;
            font-size: 0.65rem;
            font-weight: 700;
            letter-spacing: 2px;
            padding: 4px 10px;
            border-radius: 2px;
            z-index: 2;
        }

        .dish-card:hover {
            border-color: var(--border-glow);
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.7);
        }

        .dish-preview {
            height: 140px;
            background: radial-gradient(circle at center, rgba(230, 81, 0, 0.25), rgba(18, 20, 18, 0.9));
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 3.5rem;
            border-bottom: 1px solid rgba(255,255,255,0.05);
            position: relative;
        }

        .dish-body {
            padding: 24px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            flex-grow: 1;
        }

        .dish-top {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 10px;
            gap: 15px;
        }

        .dish-title {
            font-family: var(--font-serif);
            font-size: 1.4rem;
            color: var(--text-light);
        }

        .dish-price {
            font-family: var(--font-serif);
            font-size: 1.5rem;
            color: var(--ash-gold);
            white-space: nowrap;
            font-weight: 600;
        }

        .dish-desc {
            color: var(--text-dim);
            font-size: 0.9rem;
            font-weight: 300;
            line-height: 1.55;
            margin-bottom: 20px;
        }

        .dish-tags {
            display: flex;
            gap: 8px;
        }

        .tag {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            padding: 4px 10px;
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.08);
            color: var(--ash-gold);
            border-radius: 20px;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* MODAL BOOKING */
        .modal-booking {
            position: fixed;
            inset: 0;
            background: rgba(9, 10, 9, 0.95);
            backdrop-filter: blur(20px);
            z-index: 1000;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.4s ease;
        }

        .modal-booking.open {
            opacity: 1;
            pointer-events: auto;
        }

        .modal-card {
            width: 100%;
            max-width: 540px;
            padding: 50px 40px;
            border: 1px solid var(--border-glow);
            background: var(--stone-dark);
            text-align: center;
            position: relative;
            box-shadow: 0 25px 70px rgba(0,0,0,0.9);
            border-radius: 6px;
        }

        .close-modal {
            position: absolute;
            top: 20px; right: 25px;
            color: var(--text-dim);
            font-size: 1.8rem;
            cursor: pointer;
        }

        .modal-card h3 {
            font-family: var(--font-serif);
            font-size: 2.4rem;
            margin-bottom: 8px;
            color: var(--gold-light);
        }

        .booking-inputs {
            display: flex;
            flex-direction: column;
            gap: 18px;
            margin-top: 32px;
        }

        .booking-inputs input, .booking-inputs select {
            width: 100%;
            padding: 16px;
            background: rgba(0,0,0,0.5);
            border: 1px solid var(--border);
            color: #FFF;
            font-family: var(--font-sans);
            font-size: 0.95rem;
            outline: none;
            border-radius: 4px;
        }

        footer {
            padding: 45px 0;
            text-align: center;
            background: #050505;
            color: var(--text-dim);
            font-size: 0.85rem;
            border-top: 1px solid rgba(255,255,255,0.05);
            position: relative;
            z-index: 2;
        }

        @media (max-width: 992px) {
            header { padding: 20px 24px; }
            .hero-title { font-size: 3rem; }
            .menu-grid { grid-template-columns: 1fr; }
            .menu-experience { padding: 30px 20px; }
        }
    </style>
</head>
<body>

    <canvas id="canvas-sparks"></canvas>

    <!-- Header -->
    <header>
        <a href="#" class="brand-logo">Печь <span>&</span> Соль</a>
        <button class="btn-reserve-trigger" onclick="toggleModal(true)">Забронировать Стол</button>
    </header>

    <!-- Hero Screen -->
    <section class="hero-screen">
        <div class="hearth-interactive" onclick="triggerFlameEffect()">
            <span class="hearth-hint">Нажмите, чтобы разжечь</span>
        </div>
        <h1 class="hero-title">Печь & Соль</h1>
        <p class="hero-sub">Гастрономия живого огня, диких сибирских рецептов и ремесленного хлеба в самом сердце Новосибирска.</p>
    </section>

    <!-- Menu Section -->
    <section class="section-padding">
        <div class="container">
            <div class="section-header">
                <span class="story-badge">Гастрономический акцент</span>
                <h2 class="story-heading">Фирменные Позиции Меню</h2>
            </div>

            <div class="menu-experience">
                <div class="menu-nav">
                    <button class="menu-tab active" onclick="loadMenu('fire', this)">Очаг & Печь</button>
                    <button class="menu-tab" onclick="loadMenu('wild', this)">Дичь & Лес</button>
                    <button class="menu-tab" onclick="loadMenu('craft', this)">Крафт & Настойки</button>
                </div>

                <div class="menu-grid" id="menuTarget">
                    <!-- Динамический рендеринг -->
                </div>
            </div>
        </div>
    </section>

    <!-- Modal Booking -->
    <div class="modal-booking" id="bookingModal">
        <div class="modal-card">
            <span class="close-modal" onclick="toggleModal(false)">&times;</span>
            <h3>Резерв Стола</h3>
            <p style="color: var(--text-dim); font-size: 0.9rem;">Прикоснитесь к культуре сибирского огня</p>
            
            <form class="booking-inputs" id="interactiveForm">
                <input type="text" id="bName" placeholder="Ваше Имя" required>
                <input type="tel" id="bPhone" placeholder="Номер телефона" required>
                <input type="date" id="bDate" required>
                <select id="bGuests" required>
                    <option value="">Количество Гостей</option>
                    <option value="1 персона">1 персона</option>
                    <option value="2 персоны">2 человека</option>
                    <option value="3-4 персоны">3–4 человека</option>
                    <option value="5+ гостей">Компания (5+ гостей)</option>
                </select>
                <button type="submit" class="btn-reserve-trigger" style="width: 100%; background: var(--ember-orange); color: #FFF; border: none; font-weight: 600; padding: 16px;">Подтвердить резерв</button>
            </form>
        </div>
    </div>

    <footer>
        <div class="container">
            <p>© 2026 Ресторан «Печь и соль» • Новосибирск. Все права защищены.</p>
        </div>
    </footer>

    <script>
        const menuDB = {
            fire: [
                { title: "Томленая лопатка барана", desc: "Приготовлена в печи с соусом из таежной брусники и запеченным картофелем", price: "980 ₽", tags: ["Печь", "Хит"], featured: true, icon: "🍖" },
                { title: "Стерлядь на дубовых углях", desc: "С соусом из печеных томатов, пряными травами и лимоном", price: "1 250 ₽", tags: ["Рыба", "Шеф"], featured: true, icon: "🐟" },
                { title: "Пирог с белыми грибами", desc: "Хрустящее тесто на фермерском масле из дровяной печи", price: "640 ₽", tags: ["Выпечка"], featured: false, icon: "🥧" },
                { title: "Утка с моченой брусникой", desc: "Томленая ножка конфи с пюре из печеной тыквы", price: "890 ₽", tags: ["Печь"], featured: false, icon: "🍗" }
            ],
            wild: [
                { title: "Тар-тар из мяса оленя", desc: "С клюквенным соусом, каперсами и хрустящим подовым хлебом", price: "740 ₽", tags: ["Дичь", "Закуска"], featured: true, icon: "🥩" },
                { title: "Строганина из Муксуна", desc: "Подается на ледяной глыбе с крупной морской солью и перцем", price: "790 ₽", tags: ["Свежий улов"], featured: false, icon: "🧊" },
                { title: "Пельмени с мясом косули", desc: "Ручная лепка на крепком грибном бульоне со сметаной", price: "720 ₽", tags: ["Традиции"], featured: false, icon: "🥟" },
                { title: "Ассорти сибирских солений", desc: "Хрустящие грузди, соленые черри и маринованный чеснок", price: "620 ₽", tags: ["Соления"], featured: false, icon: "🧄" }
            ],
            craft: [
                { title: "Настойка Кедровая на меду", desc: "Фирменный купаж собственного приготовления (50 мл)", price: "280 ₽", tags: ["Крафт"], featured: true, icon: "🥃" },
                { title: "Сбитень на облепихе", desc: "Горячий мед, облепиха, специи и гвоздика", price: "390 ₽", tags: ["Согревающий"], featured: false, icon: "☕" },
                { title: "Таежный сбор", desc: "Иван-чай, брусничный лист, чабрец, сушеная морошка", price: "420 ₽", tags: ["Чай"], featured: false, icon: "🫖" },
                { title: "Настойка Клюквенная", desc: "Настойка на дикой сибирской клюкве (50 мл)", price: "280 ₽", tags: ["Крафт"], featured: false, icon: "🍷" }
            ]
        };

        function loadMenu(key, el) {
            document.querySelectorAll('.menu-tab').forEach(b => b.classList.remove('active'));
            if(el) el.classList.add('active');
            
            const target = document.getElementById('menuTarget');
            target.innerHTML = menuDB[key].map(item => `
                <div class="dish-card ${item.featured ? 'featured' : ''}">
                    <div class="dish-preview">
                        <span>${item.icon}</span>
                    </div>
                    <div class="dish-body">
                        <div>
                            <div class="dish-top">
                                <h4 class="dish-title">${item.title}</h4>
                                <span class="dish-price">${item.price}</span>
                            </div>
                            <p class="dish-desc">${item.desc}</p>
                        </div>
                        <div class="dish-tags">
                            ${item.tags.map(t => `<span class="tag">${t}</span>`).join('')}
                        </div>
                    </div>
                </div>
            `).join('');
        }

        function toggleModal(show) {
            document.getElementById('bookingModal').classList.toggle('open', show);
        }

        const canvas = document.getElementById('canvas-sparks');
        const ctx = canvas.getContext('2d');
        let width = canvas.width = window.innerWidth;
        let height = canvas.height = window.innerHeight;

        window.addEventListener('resize', () => {
            width = canvas.width = window.innerWidth;
            height = canvas.height = window.innerHeight;
        });

        const particles = [];
        for(let i=0; i<45; i++) {
            particles.push({
                x: Math.random() * width,
                y: Math.random() * height,
                r: Math.random() * 2 + 1,
                speedY: Math.random() * 1.5 + 0.4,
                opacity: Math.random()
            });
        }

        function drawSparks() {
            ctx.clearRect(0, 0, width, height);
            particles.forEach(p => {
                ctx.beginPath();
                ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
                ctx.fillStyle = `rgba(255, 111, 0, ${p.opacity})`;
                ctx.fill();

                p.y -= p.speedY;
                if(p.y < 0) {
                    p.y = height;
                    p.x = Math.random() * width;
                }
            });
            requestAnimationFrame(drawSparks);
        }

        function triggerFlameEffect() {
            for(let i=0; i<30; i++) {
                particles.push({
                    x: width / 2,
                    y: height / 2.5,
                    r: Math.random() * 3 + 1,
                    speedY: (Math.random() - 0.5) * 6,
                    opacity: 1
                });
            }
        }

        document.addEventListener('DOMContentLoaded', () => {
            loadMenu('fire');
            drawSparks();
        });

        document.getElementById('interactiveForm').addEventListener('submit', function(e) {
            e.preventDefault();
            alert('Ваш стол успешно забронирован!');
            toggleModal(false);
            this.reset();
        });
    </script>
</body>
</html>
